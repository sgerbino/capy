import testing ;

project
    : requirements
      $(c20-requires)
      <library>/boost/capy//boost_capy
      <exception-handling>off
      <toolset>msvc:<define>_HAS_EXCEPTIONS=0
      <warnings>extra
      <warnings-as-errors>on
    ;

